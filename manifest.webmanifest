{
  "id": "./",
  "name": "Estúdio — gravação e edição de áudio",
  "short_name": "Estúdio",
  "description": "Grave, edite e finalize áudio no seu computador, com assistente de gravação. Funciona offline.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#16171a",
  "theme_color": "#16171a",
  "related_applications": [{ "platform": "webapp", "url": "https://fbi0l.github.io/estudio/manifest.webmanifest" }],
  "categories": ["music", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/wav": [".wav"],
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/flac": [".flac"],
        "audio/webm": [".weba"]
      }
    }
  ],
  "shortcuts": [
    { "name": "Gravar agora", "url": "./?acao=gravar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
